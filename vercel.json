{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "vite --port $PORT",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/til-dig",
      "destination": "/index.html"
    },
    {
      "source": "/donation/retur",
      "destination": "/tak-stoette.html"
    }
  ],
  "redirects": [
    {
      "source": "/stoettemedlemskab",
      "destination": "/stoet",
      "permanent": true
    },
    {
      "source": "/trivselsgruppe",
      "destination": "/trivselsgrupper",
      "permanent": true
    },
    {
      "source": "/akut",
      "destination": "/hjaelp#akut",
      "permanent": true
    },
    {
      "source": "/landskaber/:slug*",
      "destination": "/trivselsgrupper",
      "permanent": true
    },
    {
      "source": "/vilkaar",
      "destination": "/brugerbetingelser",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://checkout.stripe.com https://tally.so; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.stripe.com; frame-src https://www.youtube-nocookie.com https://js.stripe.com https://checkout.stripe.com https://hooks.stripe.com https://tally.so; connect-src 'self' https://api.mitlivmed.dk https://eu.i.posthog.com https://eu-assets.i.posthog.com https://api.stripe.com https://checkout.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
